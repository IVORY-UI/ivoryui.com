<section id="toggle" class="docs-section">
  <h1 class="section-title">Toggle Switch</h1>
  <div class="section-body">
    <p>Toggle Switch is an on/off control, built on top of the checkbox. It can be toggled by clicking.</p>
    <h6>Here is a sample toggle</h6>
    <div class="iv-toggle-switch mb-2">
      <input type="checkbox" name="phone" value="phone" id="phone">
      <label for="phone"></label>
    </div>
    <div>
      <pre>
                <code>
                  &lt;div class="iv-toggle-switch"&gt;<br/>
                  &nbsp;&nbsp;&lt;input type="checkbox" name="phone" value="phone" id="phone"&gt;<br/>
                  &nbsp;&nbsp;&lt;label for="phone"&gt;&lt;/label&gt;<br/>
                  &lt;/div&gt;
                </code>
              </pre>
    </div>
  </div>
</section>