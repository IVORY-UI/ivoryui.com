<section id="tabler" class="docs-section">
  <h1 class="section-title">Radio Tabler</h1>
  <div class="section-body">
    <p>Tabler radio buttons are useful in various scenarios, especially in e-commerce applications.</p>

    <div class="row">
      <div class="col">
        <h6>Example:</h6>
        <div class="mb-2">
          <p class="p-bold">Select Size</p>
          <div class="iv-tabler">
            <div class="tabler-item">
              <input type="radio" class="tabler-input" id="tblr1" name="mytblr1" value="S" />
              <label class="tabler-button" for="tblr1">S</label>
            </div>
            <div class="tabler-item">
              <input type="radio" class="tabler-input" id="tblr2" name="mytblr1" value="M" />
              <label class="tabler-button" for="tblr2">M</label>
            </div>
            <div class="tabler-item">
              <input type="radio" class="tabler-input" id="tblr3" name="mytblr1" value="L" />
              <label class="tabler-button" for="tblr3">L</label>
            </div>
            <div class="tabler-item">
              <input type="radio" class="tabler-input" id="tblr4" name="mytblr1" value="XL" />
              <label class="tabler-button" for="tblr4">XL</label>
            </div>
          </div>
        </div>
        <div class="mb-2">
          <p class="p-bold">Select Color</p>
          <div class="iv-tabler">
            <div class="tabler-item">
              <input type="radio" class="tabler-input" id="tblrbk" name="mytblr2" value="Black" />
              <label class="tabler-button" for="tblrbk">Black</label>
            </div>
            <div class="tabler-item">
              <input type="radio" class="tabler-input" id="tblrwh" name="mytblr2" value="White" />
              <label class="tabler-button" for="tblrwh">White</label>
            </div>
            <div class="tabler-item">
              <input type="radio" class="tabler-input" id="tblrbl" name="mytblr2" value="Blue" />
              <label class="tabler-button" for="tblrbl">Blue</label>
            </div>
          </div>
        </div>
      </div>
      <div class="col">
        <div class="mb-2">
          <pre>
                    <code>
                      &lt;div class="iv-tabler"&gt;<br/>
                      &nbsp;&nbsp;&lt;div class="tabler-item"&gt;<br/>
                      &nbsp;&nbsp;&nbsp;&nbsp;&lt;input type="radio" class="tabler-input" id="t1" name="my-tabler" value="Black" /&gt;<br/>
                      &nbsp;&nbsp;&nbsp;&nbsp;&lt;label class="tabler-button" for="t1"&gt;Black&lt;/label&gt;<br/>
                      &nbsp;&nbsp;&lt;/div&gt;<br/>
                      &nbsp;&nbsp;...<br/>
                      &lt;/div&gt;
                    </code>
                  </pre>
        </div>
      </div>
    </div>
  </div>
</section>