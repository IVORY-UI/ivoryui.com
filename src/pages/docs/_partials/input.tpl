<section id="input" class="docs-section">
  <h1 class="section-title">Input</h1>
  <div class="section-body">
    <p>IVORY follows the native input element for the input field, which should be having the class <span
        class="code">.iv-input</span></p>
    <div class="row">
      <div class="col">
        <input class="iv-input" type="text" placeholder="Enter Text Here" value="" />
      </div>
      <div class="col">
        <pre>
                  <code>
                    &lt;input class="iv-input" type="text" placeholder="Enter Text Here" value="" /&gt;
                  </code>
                </pre>
      </div>
    </div>
  </div>
</section>