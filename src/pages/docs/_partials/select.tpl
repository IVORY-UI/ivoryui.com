<section id="select" class="docs-section">
  <h1 class="section-title">Select</h1>
  <div class="section-body">
    <p>A select box gives the provision to select one item from the list items.</p>
    <p>Here is an example for sample dropdown</p>
    <div class="row">
      <div class="col-4">
        <div class="iv-select">
          <select placeholder="Select">
            <option value="1">Maryland</option>
            <option value="2">Chicago</option>
            <option value="3">Hamilton</option>
          </select>
        </div>
      </div>
    </div>

    <div style="margin: 2rem 0">
      <pre>
                <code>
                  &lt;div class="iv-select"&gt;<br/>
                  &nbsp;&nbsp;&lt;select placeholder="Select"&gt;<br/>
                  &nbsp;&nbsp;&nbsp;&nbsp;&lt;option value="1"&gt;Maryland&lt;/option&gt;<br/>
                  &nbsp;&nbsp;&nbsp;&nbsp;&lt;option value="2"&gt;Chicago&lt;/option&gt;<br/>
                  &nbsp;&nbsp;&nbsp;&nbsp;&lt;option value="3"&gt;Hamilton&lt;/option&gt;<br/>
                  &nbsp;&nbsp;&lt;/select&gt;<br/>
                  &lt;/div&gt;
                </code>
              </pre>
    </div>

  </div>
</section>