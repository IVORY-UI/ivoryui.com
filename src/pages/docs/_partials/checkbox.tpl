<section id="checkbox" class="docs-section">
  <h1 class="section-title">Checkbox</h1>
  <div class="section-body">
    <div class="iv-checkbox">
      <input type="checkbox" id="check1" />
      <label for="check1">Checkbox</label>
    </div>
    <div class="iv-checkbox">
      <input type="checkbox" id="check2" checked />
      <label for="check2">Checked Checkbox</label>
    </div>
    <div class="mb-2">
      <pre>
                <code>
                  &lt;div class="iv-checkbox"&gt;<br/>
                  &nbsp;&nbsp;&lt;input type="checkbox" id="check1" /&gt;<br/>
                  &nbsp;&nbsp;&lt;label for="check1">Checkbox&lt;label&gt;<br/>
                  &lt;div&gt;<br/>
                  &lt;div class="iv-checkbox"&gt;<br/>
                  &nbsp;&nbsp;&lt;input type="checkbox" id="check2" checked /&gt;<br/>
                  &nbsp;&nbsp;&lt;label for="check2">Checked Checkbox&lt;/label&gt;<br/>
                  &lt;/div&gt;
                </code>
              </pre>
    </div>

    <h6 class="section-subtitle">Disabled</h6>
    <p>The checkbox can be disabled by <span class="code">disabled</span> attribute on the checkbox input.</p>
    <div class="iv-checkbox">
      <input type="checkbox" id="check3" disabled />
      <label for="check3">Disabled Checkbox</label>
    </div>
    <div class="iv-checkbox">
      <input type="checkbox" id="check4" disabled checked />
      <label for="check4">Checkbox disabled & checked</label>
    </div>
    <div class="mb-2">
      <pre>
                <code>
                  &lt;div class="iv-checkbox"&gt;<br/>
                  &nbsp;&nbsp;&lt;input type="checkbox" id="check3" disabled /&gt;<br/>
                  &nbsp;&nbsp;&lt;label for="check3">Disabled Checkbox&lt;label&gt;<br/>
                  &lt;div&gt;<br/>
                  &lt;div class="iv-checkbox"&gt;<br/>
                  &nbsp;&nbsp;&lt;input type="checkbox" id="check4" disabled checked /&gt;<br/>
                  &nbsp;&nbsp;&lt;label for="check4">Checkbox disabled & checked&lt;/label&gt;<br/>
                  &lt;/div&gt;
                </code>
              </pre>
    </div>
  </div>
</section>