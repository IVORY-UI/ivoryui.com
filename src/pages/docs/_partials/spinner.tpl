<section id="spinner" class="docs-section">
  <h1 class="section-title">Spinner</h1>
  <div class="section-body">
    <p>A loading spinner is used for indicating a loading state of a page or section. It can be colored according to the
      applied
      colors on the current page.</p>
    <p>IVORY provides the spinner in 5 sizes:</p>
    <div style="width: 420px; margin-bottom: 2rem;">
      <div class="row">
        <div class="col">
          <div class="iv-spinner-16"></div>
        </div>
        <div class="col">
          <div class="iv-spinner-24"></div>
        </div>
        <div class="col">
          <div class="iv-spinner-32"></div>
        </div>
        <div class="col">
          <div class="iv-spinner-40"></div>
        </div>
        <div class="col">
          <div class="iv-spinner-48"></div>
        </div>
      </div>
    </div>
    <div>
      <pre>
                <code>
                  &lt;div class="iv-spinner-16"&gt;&lt;/div&gt;<br/>
                  &lt;div class="iv-spinner-24"&gt;&lt;/div&gt;<br/>
                  &lt;div class="iv-spinner-32"&gt;&lt;/div&gt;<br/>
                  &lt;div class="iv-spinner-40"&gt;&lt;/div&gt;<br/>
                  &lt;div class="iv-spinner-48"&gt;&lt;/div&gt;
                </code>
              </pre>
    </div>
  </div>
</section>