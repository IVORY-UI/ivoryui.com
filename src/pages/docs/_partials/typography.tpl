<section id="typo" class="docs-section">
  <h1 class="section-title">Typography</h1>
  <div class="section-body">

    <div class="mb-2">
      <h6 class="section-subtitle">Type System</h6>
      <div class="type-system">
        <table>
          <thead>
            <tr>
              <th>Style</th>
              <th>Usage</th>
              <th>Font Size / Line Height</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <h1>Heading1</h1>
              </td>
              <td><span>&lt;h1&gt;...&lt;/h1&gt;</span></td>
              <td><span>2.25rem / 2.75rem</span></td>
            </tr>
            <tr>
              <td>
                <h2>Heading2</h2>
              </td>
              <td><span>&lt;h2&gt;...&lt;/h2&gt;</span></td>
              <td><span>2rem / 2.5rem</span></td>
            </tr>
            <tr>
              <td>
                <h3>Heading3</h3>
              </td>
              <td><span>&lt;h3&gt;...&lt;/h3&gt;</span></td>
              <td><span>1.75rem / 2.25rem</span></td>
            </tr>
            <tr>
              <td>
                <h4>Heading4</h4>
              </td>
              <td><span>&lt;h4&gt;...&lt;/h4&gt;</span></td>
              <td><span>1.5rem / 2rem</span></td>
            </tr>
            <tr>
              <td>
                <h5>Heading5</h5>
              </td>
              <td><span>&lt;h5&gt;...&lt;/h5&gt;</span></td>
              <td><span>1.25rem / 2rem</span></td>
            </tr>
            <tr>
              <td>
                <h6>Heading6</h6>
              </td>
              <td><span>&lt;h6&gt;...&lt;/h6&gt;</span></td>
              <td><span>1.125rem / 1.75rem</span></td>
            </tr>
            <tr>
              <td>
                <p>P</p>
              </td>
              <td><span>&lt;p&gt;....&lt;/p&gt;</span></td>
              <td><span>0.875rem / 1.5rem</span></td>
            </tr>
            <tr>
              <td>
                <p>.text-16</p>
              </td>
              <td><span>class=".text-16"</span></td>
              <td><span>1rem / 1.75rem</span></td>
            </tr>
            <tr>
              <td>
                <p>.text-12</p>
              </td>
              <td><span>class=".text-12"</span></td>
              <td><span>0.75rem / 1.25rem</span></td>
            </tr>
          </tbody>
        </table>
      </div>
